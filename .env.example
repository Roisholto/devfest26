# Both services load .env automatically. Never commit your actual .env.
# Exported environment variables take precedence.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/your_database?sslmode=disable
GEMINI_API_KEY=your-gemini-api-key
# Optional; defaults to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.6-flash
