# Loaded automatically by the Go binaries and scripts/env.sh. Never commit .env.
# Exported variables override file values. DATABASE_URL is the canonical DB key;
# PAYMENT_DATABASE_URL remains a legacy fallback when DATABASE_URL is unset.
WORKSHOP_INSTANCE=participant
MODEL_MODE=scripted
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_API_KEY=
# DATABASE_URL=postgres://devfest26_participant@127.0.0.1:55432/devfest26_participant?sslmode=disable
# WORKSHOP_CHECKPOINT=main
# TRANSFER_LIMIT_KOBO=10000000
